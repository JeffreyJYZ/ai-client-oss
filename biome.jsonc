{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		// `docs/reference.generated.ts` is machine-written by `scripts/build-docs.ts`
		// and validated by `docs/reference.test.ts`. Biome must not reformat it: a
		// formatter pass would make the artifact differ from its generator's output,
		// which is exactly what the coverage gate compares.
		"includes": ["**", "!**/.vercel", "!**/web/src/docs/reference.generated.ts"]
	},
	"vcs": {
		"useIgnoreFile": true,
		"enabled": true,
		"clientKind": "git"
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"plugins": [
		{
			"path": "./biome-plugins/no-async-fn.grit",
			"includes": ["**/web/src/**", "!**/*.test.ts"]
		},
		{
			"path": "./biome-plugins/no-await.grit",
			"includes": ["**/web/src/**", "!**/*.test.ts"]
		},
		{
			"path": "./biome-plugins/no-throw.grit",
			"includes": ["**/web/src/**", "!**/*.test.ts"]
		},
		{
			"path": "./biome-plugins/no-try-catch.grit",
			"includes": ["**/web/src/**", "!**/*.test.ts"]
		},
		{
			"path": "./biome-plugins/no-new-promise.grit",
			"includes": ["**/web/src/**", "!**/*.test.ts"]
		}
	]
}
